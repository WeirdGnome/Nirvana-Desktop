#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Nirvana Desktop: the session's start. Sourced by the session script (nirvana-session)
# before the desktop starts; setup-env.sh copies it to ~/.nirvana/Startup-Sequence.
# Your own assigns go at the end ("assign Work: '/srv/work' --desktop"); the Assigns
# editor's Save writes them there too.

# The commands of Nirvana first.
case ":$PATH:" in
    *:/opt/nirvana/C:*) ;;
    *) PATH="/opt/nirvana/C:$PATH" ;;
esac
export PATH

# The global menu: programs put their menus in the screen bar.
case ":${GTK_MODULES:-}:" in
    *:appmenu-gtk-module:*) ;;
    *) GTK_MODULES="${GTK_MODULES:+$GTK_MODULES:}appmenu-gtk-module" ;;
esac
export GTK_MODULES
export UBUNTU_MENUPROXY=1
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-appmenu-qt5}"
export KDE_SESSION_VERSION="${KDE_SESSION_VERSION:-5}"
export SAL_USE_VCLPLUGIN="${SAL_USE_VCLPLUGIN:-gtk3}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Nirvana}"

# The default assigns (SYS:, Home:, RAM:, Nirvana:, Themes:, Tools:, the user folders).
assign --init --quiet

# Your assigns:
