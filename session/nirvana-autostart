#!/bin/sh
# Nirvana Desktop - autostart sesji wg XDG Autostart Specification
#
# Uruchamia pliki .desktop z ~/.config/autostart i katalogów $XDG_CONFIG_DIRS
# (domyślnie /etc/xdg/autostart). Plik użytkownika o tej samej nazwie zastępuje
# systemowy (Hidden=true wyłącza wpis). Respektuje OnlyShowIn/NotShowIn
# (nazwa pulpitu: Nirvana) i TryExec. Kody %f %u %U... są pomijane.
# nm-applet jest pomijany (Nirvana Desktop ma menu sieci; NIRVANA_NM_APPLET=1 go włącza).
# Na końcu, gdy żaden autostart nie dał agenta polkit, uruchamia pierwszego
# znalezionego - bez niego montowanie dysków i tryb root nie zapytają o hasło.
#
#   nirvana-autostart [-n]      -n: tylko wypisz, co zostałoby uruchomione

DRY=
[ "$1" = "-n" ] && DRY=1
DESK="${XDG_CURRENT_DESKTOP:-Nirvana}"
SEEN=" "

dirs="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
IFS_OLD=$IFS; IFS=:
for d in ${XDG_CONFIG_DIRS:-/etc/xdg}; do dirs="$dirs:$d/autostart"; done
IFS=$IFS_OLD

# wartość klucza z sekcji [Desktop Entry]
key() {
  awk -v k="$2" '
    /^\[/ { s = ($0 == "[Desktop Entry]"); next }
    s && index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$1"
}

# czy lista "A;B;C;" zawiera któryś z pulpitów z $DESK (rozdzielonych ":")
in_list() {
  list=";$1;"
  IFS_OLD=$IFS; IFS=:
  for x in $DESK; do
    case "$list" in *";$x;"*) IFS=$IFS_OLD; return 0 ;; esac
  done
  IFS=$IFS_OLD
  return 1
}

polkit_started=
IFS_OLD=$IFS; IFS=:
for d in $dirs; do
  IFS=$IFS_OLD
  [ -d "$d" ] || { IFS=:; continue; }
  for f in "$d"/*.desktop; do
    [ -f "$f" ] || continue
    name=$(basename "$f")
    case "$SEEN" in *" $name "*) continue ;; esac   # pierwszy wygrywa (użytkownik)
    SEEN="$SEEN$name "
    # Nirvana Desktop ma własne menu sieci na pasku - aplet NetworkManagera byłby drugim
    [ "$name" = "nm-applet.desktop" ] && [ -z "$NIRVANA_NM_APPLET" ] && continue
    [ "$(key "$f" Hidden)" = "true" ] && continue
    [ "$(key "$f" Type)" = "Application" ] || [ -z "$(key "$f" Type)" ] || continue
    only=$(key "$f" OnlyShowIn); not=$(key "$f" NotShowIn)
    if [ -n "$only" ]; then in_list "$only" || continue; fi
    if [ -n "$not" ]; then in_list "$not" && continue; fi
    try=$(key "$f" TryExec)
    if [ -n "$try" ] && ! command -v "$try" >/dev/null 2>&1; then continue; fi
    cmd=$(key "$f" Exec | sed -e 's/%[fFuUdDnNickvm]//g' -e 's/%%/%/g')
    [ -n "$cmd" ] || continue
    case "$cmd" in *polkit*) polkit_started=1 ;; esac
    if [ -n "$DRY" ]; then echo "$name: $cmd"; else (eval "exec $cmd" >/dev/null 2>&1 &); fi
  done
  IFS=:
done
IFS=$IFS_OLD

# agent polkit (okno hasła administratora)
if [ -z "$polkit_started" ]; then
  for a in lxpolkit \
           /usr/lib/*/polkit-mate/polkit-mate-authentication-agent-1 \
           /usr/libexec/polkit-mate-authentication-agent-1 \
           /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
           /usr/libexec/polkit-gnome-authentication-agent-1 \
           lxqt-policykit-agent /usr/lib/*/libexec/polkit-kde-authentication-agent-1; do
    p=$(command -v "$a" 2>/dev/null) || continue
    [ -x "$p" ] || continue
    if [ -n "$DRY" ]; then echo "polkit: $p"; else ("$p" >/dev/null 2>&1 &); fi
    break
  done
fi
