#, c-format
msgid "Type the PIN for “%s” (often 0000 or 1234 - see its manual):"
msgstr "Wpisz PIN dla „%s” (często 0000 albo 1234 - zajrzyj do instrukcji):"

#: alice/bluetooth.cxx:148
#, c-format
msgid "Type the code shown on “%s”:"
msgstr "Wpisz kod wyświetlony na „%s”:"

#: alice/bluetooth.cxx:153
msgid "Type %1 on “%2” and press Enter there."
msgstr "Wpisz %1 na „%2” i naciśnij tam Enter."

#: alice/bluetooth.cxx:156
#, c-format
msgid "“%s” asks for permission to connect. Allow it?"
msgstr "„%s” prosi o zgodę na połączenie. Zezwolić?"

#: alice/bluetooth.cxx:156
msgid "Deny"
msgstr "Odmów"

#: alice/bluetooth.cxx:156 denise/shield_applet.cxx:196
