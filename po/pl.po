msgid "Bluetooth is off."
msgstr "Bluetooth jest wyłączony."

#: alice/bluetooth.cxx:111
msgid "Other devices see this computer as “%1”."
msgstr "Inne urządzenia widzą ten komputer jako „%1”."

#: alice/bluetooth.cxx:140
#, c-format
msgid ""
"Does “%s” show the code %s?\n"
"\n"
"Confirm only when the codes are the same."
msgstr ""
"Czy „%s” pokazuje kod %s?\n"
"\n"
"Potwierdź tylko, jeśli kody są takie same."

