/*
 * Nirvana Desktop - the "Classic 1.3" theme: four colours - blue, white, black, orange - sharp pixels, no shadows.
 * Its groups are common.edc's; its images are drawn by tools/make-theme-images.py.
 */

#define FN "Monospace"
#define FNB "Monospace:style=Bold"
#define FS 10
#define FSS 9
#define BAR_H 20
#define MENU_H 18
#define TITLE_H 20
#define ICON_TEXT_EFFECT PLAIN

data {
   item: "nirvana/theme/name" "Classic 1.3";
   item: "nirvana/screenbar/height" "20";
   item: "nirvana/frame/gadgets/left" "close";
   item: "nirvana/frame/gadgets/right" "depth";
   /* the colours of the toolkit's widgets (an Elementary palette) */
   item: "nirvana/widgets/palette" "light";
}

color_classes {
   color_class { name: "nirvana_bar_text"; color: 0 85 170 255; color3: 0 0 0 0; }
   color_class { name: "nirvana_bar_line"; color: 0 0 0 255; }
   color_class { name: "nirvana_menu_text"; color: 0 85 170 255; }
   color_class { name: "nirvana_menu_text_sel"; color: 255 255 255 255; }
   color_class { name: "nirvana_menu_text_disabled"; color: 120 150 200 255; }
   color_class { name: "nirvana_menu_bg"; color: 255 255 255 255; }
   color_class { name: "nirvana_menu_border"; color: 0 0 0 255; }
   color_class { name: "nirvana_menu_shadow"; color: 0 0 0 0; }
   color_class { name: "nirvana_menu_separator"; color: 0 85 170 255; }
   color_class { name: "nirvana_backdrop_text"; color: 255 255 255 110; }
   color_class { name: "nirvana_icon_text"; color: 255 255 255 255; color3: 0 0 0 0; }
   color_class { name: "nirvana_icon_text_bg"; color: 0 0 0 0; }
   color_class { name: "nirvana_icon_text_sel_bg"; color: 255 136 0 255; }
   color_class { name: "nirvana_frame_border"; color: 0 0 0 255; }
   color_class { name: "nirvana_frame_bg"; color: 255 255 255 255; }
   color_class { name: "nirvana_title_text"; color: 0 85 170 255; color3: 0 0 0 0; }
   color_class { name: "nirvana_title_text_inactive"; color: 255 255 255 255; color3: 0 0 0 0; }
   color_class { name: "nirvana_dock_shadow"; color: 0 0 0 0; }
   color_class { name: "nirvana_dock_border"; color: 0 0 0 255; }
   color_class { name: "nirvana_dock_bg"; color: 255 255 255 255; }
   color_class { name: "nirvana_dock_hover"; color: 255 136 0 120; }
   color_class { name: "nirvana_dock_pressed"; color: 0 85 170 160; }
   color_class { name: "nirvana_dock_text"; color: 0 85 170 255; }
   color_class { name: "nirvana_dock_label"; color: 0 0 0 255; }
   color_class { name: "nirvana_dock_separator"; color: 0 85 170 255; }
   color_class { name: "nirvana_dock_track"; color: 0 85 170 70; }
   color_class { name: "nirvana_dock_fill"; color: 255 136 0 255; }
}

#include "common.edc"
