/*
 * Nirvana Desktop - the "Ambient" theme: the default: soft gradients, rounded gadgets.
 * Its groups are common.edc's; its images are drawn by tools/make-theme-images.py.
 */

#define FN "Sans"
#define FNB "Sans:style=Bold"
#define FS 11
#define FSS 10
#define BAR_H 24
#define MENU_H 22
#define TITLE_H 22
#define ICON_TEXT_EFFECT SOFT_SHADOW

data {
   item: "nirvana/theme/name" "Ambient";
   item: "nirvana/screenbar/height" "24";
   item: "nirvana/frame/gadgets/left" "close";
   item: "nirvana/frame/gadgets/right" "prefs jump iconify zoom depth";
   /* the colours of the toolkit's widgets (an Elementary palette) */
   item: "nirvana/widgets/palette" "light";
}

color_classes {
   color_class { name: "nirvana_bar_text"; color: 30 32 38 255; color3: 255 255 255 160; }
   color_class { name: "nirvana_bar_line"; color: 120 124 136 255; }
   color_class { name: "nirvana_menu_text"; color: 24 26 32 255; }
   color_class { name: "nirvana_menu_text_sel"; color: 255 255 255 255; }
   color_class { name: "nirvana_menu_text_disabled"; color: 150 152 160 255; }
   color_class { name: "nirvana_menu_bg"; color: 246 247 250 250; }
   color_class { name: "nirvana_menu_border"; color: 110 114 128 255; }
   color_class { name: "nirvana_menu_shadow"; color: 0 0 0 60; }
   color_class { name: "nirvana_menu_separator"; color: 190 194 204 255; }
   color_class { name: "nirvana_backdrop_text"; color: 255 255 255 70; }
   color_class { name: "nirvana_icon_text"; color: 255 255 255 255; color3: 0 0 0 140; }
   color_class { name: "nirvana_icon_text_bg"; color: 20 30 50 140; }
   color_class { name: "nirvana_icon_text_sel_bg"; color: 70 110 190 230; }
   color_class { name: "nirvana_frame_border"; color: 96 100 112 255; }
   color_class { name: "nirvana_frame_bg"; color: 230 232 238 255; }
   color_class { name: "nirvana_title_text"; color: 255 255 255 255; color3: 30 50 90 140; }
   color_class { name: "nirvana_title_text_inactive"; color: 70 72 80 255; color3: 255 255 255 120; }
   color_class { name: "nirvana_dock_shadow"; color: 0 0 0 50; }
   color_class { name: "nirvana_dock_border"; color: 90 96 112 230; }
   color_class { name: "nirvana_dock_bg"; color: 255 255 255 235; }
   color_class { name: "nirvana_dock_hover"; color: 90 130 210 70; }
   color_class { name: "nirvana_dock_pressed"; color: 60 96 170 120; }
   color_class { name: "nirvana_dock_text"; color: 40 44 54 255; }
   color_class { name: "nirvana_dock_label"; color: 70 74 84 255; }
   color_class { name: "nirvana_dock_separator"; color: 120 126 140 200; }
   color_class { name: "nirvana_dock_track"; color: 40 44 54 60; }
   color_class { name: "nirvana_dock_fill"; color: 80 150 90 255; }
}

#include "common.edc"
