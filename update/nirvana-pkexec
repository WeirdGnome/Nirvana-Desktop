#!/bin/sh
# Nirvana Desktop - pkexec with the Nirvana password window guaranteed.
#
#   nirvana-pkexec HELPER ARGS...      (stdin and the exit code are passed through)
#
# pkexec needs a polkit agent in the user's login session. Without a session known to
# elogind/logind (startx, a login manager without pam_elogind) there is none, and pkexec ends with
# "Error creating textual authentication agent". So for every call nirvana-polkit-agent is
# started for this very process (pkexec's subject is its parent, i.e. this script); polkit asks
# that agent first. It ends together with this script.
here=$(dirname "$(readlink -f "$0")")
agent=
for c in "$here/nirvana-polkit-agent" "$here/../libexec/nirvana-polkit-agent" "$here/../build/nirvana-polkit-agent" \
         /usr/libexec/nirvana-polkit-agent; do
  [ -x "$c" ] && { agent=$c; break; }
done
apid=
if [ -n "$agent" ] && [ -n "${DISPLAY:-}" ]; then
  ready=$(mktemp "${TMPDIR:-/tmp}/nirvana-pkexec.XXXXXX") || ready=
  if [ -n "$ready" ]; then
    rm -f "$ready"
    "$agent" --process $$ --ready "$ready" </dev/null >/dev/null 2>&1 &
    apid=$!
    i=0
    while [ ! -s "$ready" ] && [ $i -lt 30 ] && kill -0 "$apid" 2>/dev/null; do sleep 0.1; i=$((i + 1)); done
    rm -f "$ready"
  fi
fi
pkexec "$@"
rc=$?
[ -n "$apid" ] && kill "$apid" 2>/dev/null
exit $rc
