#!/bin/sh
# Nirvana Desktop - looks for system updates WITHOUT root rights (used by the updates
# applet in the menu bar). One line per item, fields separated by a tab:
#   BACKEND <name>            the package manager: apt, dnf, pacman, zypper, apk, xbps, none
#   PKG <name> <version>      an available update (flatpak applications too)
#   WARN <text>               the package lists could not be refreshed - the result may be old
#
# How the lists are refreshed without root:
#   apt     the lists are downloaded into ~/.cache/nirvana/apt (no locks, the system lists
#           stay untouched - the same idea as checkupdates on Arch)
#   dnf     "dnf check-update" keeps its own cache for ordinary users
#   pacman  checkupdates (pacman-contrib) - a temporary copy of the database
#   zypper, apk, xbps   the last lists downloaded by the system (refreshing needs root)
#   flatpak remote-ls --updates
LC_ALL=C
export LC_ALL
T="$(printf '\t')"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/nirvana"
mkdir -p "$cache"
have() { command -v "$1" >/dev/null 2>&1; }
warn() { printf 'WARN%s%s\n' "$T" "$1"; }

if have apt-get && [ -r /var/lib/dpkg/status ]; then
  printf 'BACKEND%sapt\n' "$T"
  d="$cache/apt"
  mkdir -p "$d/lists/partial" "$d/archives/partial"
  user="$(id -un)"
  # the hooks of the system's apt (Pre/Post-Invoke) are meant for root - not run here
  printf '#clear APT::Update::Pre-Invoke;\n#clear APT::Update::Post-Invoke;\n#clear APT::Update::Post-Invoke-Success;\n' >"$d/apt.conf"
  own="-c $d/apt.conf -o Dir::State::Lists=$d/lists -o Dir::Cache=$d -o Dir::Cache::archives=$d/archives"
  own="$own -o Dir::Cache::pkgcache= -o Dir::Cache::srcpkgcache= -o Debug::NoLocking=1 -o APT::Sandbox::User=$user"
  # shellcheck disable=SC2086
  if apt-get -q $own update >/dev/null 2>"$d/update.err"; then
    lists=$own
  else
    warn "$(grep -m1 -E '^(E|W):' "$d/update.err" | cut -c1-160)"
    lists="-o Dir::Cache::pkgcache= -o Dir::Cache::srcpkgcache= -o Debug::NoLocking=1"   # the system lists
  fi
  # "Inst name [old] (new suite [arch])" - or without [old] for a new package
  # shellcheck disable=SC2086
  apt-get -q $lists -s dist-upgrade 2>/dev/null |
    awk -v t="$T" '/^Inst /{v=$3; if (v ~ /^\[/) v=$4; gsub(/[()]/, "", v); print "PKG" t $2 t v}'
elif have dnf; then
  printf 'BACKEND%sdnf\n' "$T"
  out="$(dnf -q check-update 2>"$cache/dnf.err")"
  [ $? -eq 1 ] && warn "$(head -n1 "$cache/dnf.err" | cut -c1-160)"
  printf '%s\n' "$out" | awk -v t="$T" '
    /^(Obsoleting|Security:)/ { exit }
    NF == 3 && $1 ~ /\./ { n = $1; sub(/\.[^.]*$/, "", n); print "PKG" t n t $2 }'
elif have pacman; then
  printf 'BACKEND%spacman\n' "$T"
  if have checkupdates; then
    checkupdates 2>/dev/null | awk -v t="$T" 'NF >= 4 { print "PKG" t $1 t $4 }'
  else
    warn "pacman-contrib (checkupdates) is not installed - the result comes from the last synchronisation"
    pacman -Qu 2>/dev/null | awk -v t="$T" 'NF >= 4 { print "PKG" t $1 t $4 }'
  fi
elif have zypper; then
  printf 'BACKEND%szypper\n' "$T"
  zypper -q --non-interactive --no-refresh list-updates 2>/dev/null |
    awk -F'|' -v t="$T" '$1 ~ /^v/ { n = $3; v = $5; gsub(/ /, "", n); gsub(/ /, "", v); print "PKG" t n t v }'
elif have apk; then
  printf 'BACKEND%sapk\n' "$T"
  apk -u list --upgradable 2>/dev/null | awk -v t="$T" 'NF { print "PKG" t $1 t "" }'
elif have xbps-install; then
  printf 'BACKEND%sxbps\n' "$T"
  xbps-install -Mun 2>/dev/null | awk -v t="$T" 'NF { print "PKG" t $1 t "" }'
else
  printf 'BACKEND%snone\n' "$T"
fi

if have flatpak; then
  flatpak remote-ls --updates --columns=application,version 2>/dev/null |
    awk -F'\t' -v t="$T" 'NF && $1 !~ /^Application/ { print "PKG" t $1 t ($2 == "" ? "Flatpak" : $2 " (Flatpak)") }'
fi
exit 0
