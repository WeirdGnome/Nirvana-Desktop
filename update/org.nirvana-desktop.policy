<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Nirvana Desktop</vendor>
  <action id="org.nirvana-desktop.update">
    <description>Install system updates</description>
    <description xml:lang="pl">Instalowanie aktualizacji systemu</description>
    <message>Authentication is required to install system updates</message>
    <message xml:lang="pl">Instalowanie aktualizacji systemu wymaga uwierzytelnienia</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nirvana-update-helper</annotate>
  </action>
  <action id="org.nirvana-desktop.power-profile">
    <description>Change the power profile</description>
    <description xml:lang="pl">Zmiana profilu zasilania</description>
    <message>Authentication is required to change the power profile</message>
    <message xml:lang="pl">Zmiana profilu zasilania wymaga uwierzytelnienia</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nirvana-power-helper</annotate>
  </action>
</policyconfig>
