<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Nirvana Desktop</vendor>
  <action id="org.nirvana-desktop.update">
    <description>Install system updates</description>
    <description xml:lang="pl">Instalowanie aktualizacji systemu</description>
    <message>Authentication is required to install system updates</message>
    <message xml:lang="pl">Instalowanie aktualizacji systemu wymaga uwierzytelnienia</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nirvana-update-helper</annotate>
  </action>
  <action id="org.nirvana-desktop.power-profile">
    <description>Change the power profile</description>
    <description xml:lang="pl">Zmiana profilu zasilania</description>
    <message>Authentication is required to change the power profile</message>
    <message xml:lang="pl">Zmiana profilu zasilania wymaga uwierzytelnienia</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nirvana-power-helper</annotate>
  </action>
  <action id="org.nirvana-desktop.time">
    <description>Change the time zone, the date and the time</description>
    <description xml:lang="pl">Zmiana strefy czasowej, daty i godziny</description>
    <message>Authentication is required to change the system time settings</message>
    <message xml:lang="pl">Zmiana ustawień czasu systemu wymaga uwierzytelnienia</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nirvana-time-helper</annotate>
  </action>
  <action id="org.nirvana-desktop.print">
    <description>Manage printers and install printer drivers</description>
    <description xml:lang="pl">Zarządzanie drukarkami i instalowanie sterowników</description>
    <message>Authentication is required to manage printers</message>
    <message xml:lang="pl">Zarządzanie drukarkami wymaga uwierzytelnienia</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nirvana-print-helper</annotate>
  </action>
  <action id="org.nirvana-desktop.user">
    <description>Change your full name, login picture and automatic login</description>
    <description xml:lang="pl">Zmiana własnego imienia i nazwiska, zdjęcia logowania i automatycznego logowania</description>
    <message>Authentication is required to change your account settings</message>
    <message xml:lang="pl">Zmiana ustawień konta wymaga uwierzytelnienia</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_self_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nirvana-user-helper</annotate>
  </action>
  <action id="org.nirvana-desktop.libs">
    <description>Install system libraries that an application needs</description>
    <description xml:lang="pl">Instalowanie bibliotek systemowych potrzebnych aplikacji</description>
    <message>Authentication is required to install the libraries an application needs</message>
    <message xml:lang="pl">Instalowanie bibliotek potrzebnych aplikacji wymaga uwierzytelnienia</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nirvana-libs-helper</annotate>
  </action>
  <action id="org.nirvana-desktop.shield">
    <description>Change the NirvanaSHIELD firewall</description>
    <description xml:lang="pl">Zmiana zapory NirvanaSHIELD</description>
    <message>Changing the firewall (which programs may use the network) needs the administrator password</message>
    <message xml:lang="pl">Zmiana zapory (które programy mogą korzystać z sieci) wymaga hasła administratora</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/nirvana-shield</annotate>
  </action>
</policyconfig>
