#!/bin/sh
# Nirvana Desktop - installs the system updates. Runs as root through pkexec
# (polkit action org.nirvana-desktop.update); the updates applet reads its output.
#
# Only one fixed job and no arguments passed on to the package manager, so the
# polkit rule that lets administrators run it without a password allows nothing else.
# Progress: apt status lines (APT::Status-Fd: dlstatus/pmstatus), the other managers
# print "(n/N)"; "STEP <name>" marks the stages.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL
[ "$(id -u)" = 0 ] || { echo "ERROR must run as root"; exit 1; }
[ "${1:-}" = upgrade ] || { echo "usage: nirvana-update-helper upgrade"; exit 2; }
have() { command -v "$1" >/dev/null 2>&1; }
step() { echo "STEP $1"; }
rc=0
if have apt-get && [ -r /var/lib/dpkg/status ]; then
  DEBIAN_FRONTEND=noninteractive
  export DEBIAN_FRONTEND
  step refresh
  apt-get -q -o APT::Status-Fd=1 update || rc=$?
  step upgrade
  apt-get -q -y -o APT::Status-Fd=1 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
    dist-upgrade || rc=$?
elif have dnf; then
  step upgrade
  dnf -y upgrade || rc=$?
elif have pacman; then
  step upgrade
  pacman -Syu --noconfirm || rc=$?
elif have zypper; then
  step refresh
  zypper --non-interactive refresh || rc=$?
  step upgrade
  zypper --non-interactive update || rc=$?
elif have apk; then
  step refresh
  apk update || rc=$?
  step upgrade
  apk upgrade || rc=$?
elif have xbps-install; then
  step upgrade
  xbps-install -Syu || rc=$?
fi
if have flatpak; then
  step flatpak
  flatpak update -y --noninteractive --system || true
fi
exit $rc
