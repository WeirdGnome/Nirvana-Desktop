#!/bin/sh
# Nirvana Desktop - system libraries that an application (AppImage) needs but does not bring.
#
#   nirvana-libs-helper packages SONAME...   which packages provide them (as the user, no root)
#   nirvana-libs-helper install SONAME...    installs them (root through pkexec, polkit action
#                                            org.nirvana-desktop.libs)
#
# Only the library names from the table below are understood, and each maps to a fixed
# package - so the helper cannot be used to install anything else.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL

# soname -> package(s): the first one that exists in the repositories is taken
pkg_for() {
  case "$1" in
    libxcb-cursor.so.0) echo libxcb-cursor0 ;;
    libxcb-icccm.so.4) echo libxcb-icccm4 ;;
    libxcb-image.so.0) echo libxcb-image0 ;;
    libxcb-keysyms.so.1) echo libxcb-keysyms1 ;;
    libxcb-render-util.so.0) echo libxcb-render-util0 ;;
    libxcb-xinerama.so.0) echo libxcb-xinerama0 ;;
    libxcb-xinput.so.0) echo libxcb-xinput0 ;;
    libxcb-xkb.so.1) echo libxcb-xkb1 ;;
    libxcb-shape.so.0) echo libxcb-shape0 ;;
    libxcb-randr.so.0) echo libxcb-randr0 ;;
    libxcb-sync.so.1) echo libxcb-sync1 ;;
    libxcb-xfixes.so.0) echo libxcb-xfixes0 ;;
    libxcb-shm.so.0) echo libxcb-shm0 ;;
    libxcb-render.so.0) echo libxcb-render0 ;;
    libxcb-glx.so.0) echo libxcb-glx0 ;;
    libxcb-util.so.1) echo libxcb-util1 ;;
    libxcb-ewmh.so.2) echo libxcb-ewmh2 ;;
    libxcb-dri3.so.0) echo libxcb-dri3-0 ;;
    libxcb-present.so.0) echo libxcb-present0 ;;
    libxcb-xkb.so.*) echo libxcb-xkb1 ;;
    libxkbcommon-x11.so.0) echo libxkbcommon-x11-0 ;;
    libxkbcommon.so.0) echo libxkbcommon0 ;;
    libX11-xcb.so.1) echo libx11-xcb1 ;;
    libEGL.so.1) echo libegl1 ;;
    libGL.so.1) echo libgl1 ;;
    libGLX.so.0) echo libglx0 ;;
    libOpenGL.so.0) echo libopengl0 ;;
    libGLESv2.so.2) echo libgles2 ;;
    libgbm.so.1) echo libgbm1 ;;
    libdrm.so.2) echo libdrm2 ;;
    libvulkan.so.1) echo libvulkan1 ;;
    libwayland-client.so.0) echo libwayland-client0 ;;
    libwayland-cursor.so.0) echo libwayland-cursor0 ;;
    libwayland-egl.so.1) echo libwayland-egl1 ;;
    libfuse.so.2) echo "libfuse2t64 libfuse2" ;;
    libfontconfig.so.1) echo libfontconfig1 ;;
    libfreetype.so.6) echo libfreetype6 ;;
    libharfbuzz.so.0) echo libharfbuzz0b ;;
    libpng16.so.16) echo "libpng16-16t64 libpng16-16" ;;
    libdbus-1.so.3) echo libdbus-1-3 ;;
    libglib-2.0.so.0|libgobject-2.0.so.0|libgio-2.0.so.0|libgthread-2.0.so.0|libgmodule-2.0.so.0)
      echo "libglib2.0-0t64 libglib2.0-0" ;;
    libgtk-3.so.0|libgdk-3.so.0) echo "libgtk-3-0t64 libgtk-3-0" ;;
    libatk-1.0.so.0) echo "libatk1.0-0t64 libatk1.0-0" ;;
    libatk-bridge-2.0.so.0) echo "libatk-bridge2.0-0t64 libatk-bridge2.0-0" ;;
    libatspi.so.0) echo "libatspi2.0-0t64 libatspi2.0-0" ;;
    libnss3.so|libnssutil3.so|libsmime3.so) echo libnss3 ;;
    libnspr4.so) echo libnspr4 ;;
    libcups.so.2) echo "libcups2t64 libcups2" ;;
    libasound.so.2) echo "libasound2t64 libasound2" ;;
    libpulse.so.0) echo libpulse0 ;;
    libsecret-1.so.0) echo libsecret-1-0 ;;
    libnotify.so.4) echo libnotify4 ;;
    libXss.so.1) echo libxss1 ;;
    libXtst.so.6) echo libxtst6 ;;
    libXrandr.so.2) echo libxrandr2 ;;
    libXcomposite.so.1) echo libxcomposite1 ;;
    libXdamage.so.1) echo libxdamage1 ;;
    libXi.so.6) echo libxi6 ;;
    libXcursor.so.1) echo libxcursor1 ;;
    libXinerama.so.1) echo libxinerama1 ;;
    libXfixes.so.3) echo libxfixes3 ;;
    libXrender.so.1) echo libxrender1 ;;
    libXext.so.6) echo libxext6 ;;
    libSM.so.6) echo libsm6 ;;
    libICE.so.6) echo libice6 ;;
    libz.so.1) echo zlib1g ;;
    libssl.so.3|libcrypto.so.3) echo "libssl3t64 libssl3" ;;
    libpcre2-16.so.0) echo libpcre2-16-0 ;;
    libdouble-conversion.so.3) echo libdouble-conversion3 ;;
    libmd4c.so.0) echo libmd4c0 ;;
    libb2.so.1) echo libb2-1 ;;
    libzstd.so.1) echo libzstd1 ;;
    libbrotlidec.so.1) echo libbrotli1 ;;
    libicuuc.so.*|libicui18n.so.*|libicudata.so.*) echo "libicu76 libicu74 libicu72" ;;
    libsqlite3.so.0) echo libsqlite3-0 ;;
    libgcrypt.so.20) echo libgcrypt20 ;;
    libsystemd.so.0) echo "libelogind0 libsystemd0" ;;
    libudev.so.1) echo "libeudev1 libudev1" ;;
    libjack.so.0) echo "libjack-jackd2-0" ;;
    libSDL2-2.0.so.0) echo "libsdl2-2.0-0" ;;
    *) echo "" ;;
  esac
}

available() { apt-cache show "$1" >/dev/null 2>&1; }

pick() {   # the package for a soname that exists in the repositories
  for p in $(pkg_for "$1"); do
    available "$p" && { echo "$p"; return; }
  done
}

command -v apt-get >/dev/null 2>&1 || { echo "only apt-based systems (Devuan, Debian) are supported"; exit 3; }

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
packages)
  for s in "$@"; do
    p=$(pick "$s")
    [ -n "$p" ] && echo "$s $p"
  done
  exit 0
  ;;
install)
  [ "$(id -u)" = 0 ] || { echo "must run as root"; exit 1; }
  pkgs=
  for s in "$@"; do
    p=$(pick "$s")
    [ -n "$p" ] || continue
    case " $pkgs " in *" $p "*) ;; *) pkgs="$pkgs $p" ;; esac
  done
  [ -n "$pkgs" ] || { echo "nothing to install"; exit 2; }
  DEBIAN_FRONTEND=noninteractive
  export DEBIAN_FRONTEND
  # shellcheck disable=SC2086
  apt-get -q -y install --no-install-recommends $pkgs || { apt-get -q update && apt-get -q -y install --no-install-recommends $pkgs; }
  exit $?
  ;;
*)
  echo "usage: nirvana-libs-helper packages|install SONAME..."
  exit 2
  ;;
esac
